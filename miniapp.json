{
  "name": "Icarian HUD",
  "packageName": "com.icarian.hud",
  "version": "1.0.1",
  "sdkVersion": "3.1.1",
  "minHostVersion": "1.42.0",
  "type": "standard",
  "entry": {
    "background": "background/index.js",
    "ui": "ui/index.html"
  },
  "icon": "icon.png",
  "hardware": ["DISPLAY", "MICROPHONE"],
  "permissions": [
    "MICROPHONE",
    "READ_NOTIFICATIONS",
    "CALENDAR",
    "LOCATION"
  ]
}
